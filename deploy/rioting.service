[Unit]
Description=Rioting RTSP --> HLS security camera server
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/local/bin/rioting -c /home/ubuntu/config.toml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
